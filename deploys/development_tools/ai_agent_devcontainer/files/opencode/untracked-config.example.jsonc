{
  "$schema": "https://opencode.ai/config.json",
  "model": "my-favorite-model",
  "providers": {
    "opencode-go-anthropic": {
      "settings": {
        "apiKey": "apiKey",
      },
    },
    "opencode-go-openai": {
      "settings": {
        "apiKey": "apiKey",
      },
    },
    "google": {
      "settings": {
        "apiKey": "apikey",
      },
    },
    "cortecs": {
      "settings": {
        "apiKey": "apikey",
      },
    },
    "cortecs2": {
      "settings": {
        "apiKey": "apikey",
      },
    },
    "requesty": {
      "settings": {
        "apiKey": "apikey",
      },
    },
    "requesty2": {
      "settings": {
        "apiKey": "apikey",
      },
    },
    "openrouter": {
      "settings": {
        "apiKey": "apikey",
      },
    },
    "vshn-us-ai": {
      "settings": {
        "baseURL": "baseurl",
        "apiKey": "apikey",
      },
    },
    "vshn-llm-router": {
      "settings": {
        "baseURL": "{env:VSHN_LLM_ROUTER_BASE_URL}",
        "apiKey": "{env:VSHN_LLM_ROUTER_API_KEY}",
      },
    },
  },
}
