{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "allow"
  },
  "plugin": [
    // renovate: datasource=npm depName=@dietrichgebert/ponytail
    "@dietrichgebert/ponytail@4.9.0",
    // renovate: datasource=npm depName=opencode-gemini-auth
    "opencode-gemini-auth@1.4.15",
    // renovate: datasource=npm depName=bacluc-opencode-completion-check-command
    "bacluc-opencode-completion-check-command@0.9.7",
    [
      // renovate: datasource=npm depName=opencode-auto-resume
      "opencode-auto-resume@1.1.11",
      {
        "chunkTimeoutMs": 300000,
        "maxRetries": 10
      }
    ]
  ],
  "model": "openai/gpt-5.6-terra",
  "small_model": "openai/gpt-5.4-mini",
  "default_agent": "coordinator",
  "subagent_depth": 3,
  "agent": {
    "build": {
      "mode": "all"
    },
    "general": {
      "disable": true
    },
    "explore": {
      "disable": true
    },
    "carrier-go2-glm-5-2": {
      "mode": "subagent",
      "hidden": true,
      "model": "opencode-go-openai-2/glm-5.2",
      "description": "Carrier relay using verified Go2 GLM-5.2.",
      "temperature": 0.1,
      "steps": 8,
      "permission": {
        "*": "allow",
        "task": {
          "*": "allow"
        }
      },
      "prompt": "{file:./agents/relay.txt}"
    },
    "carrier-go-kimi-k2-7-code": {
      "mode": "subagent",
      "hidden": true,
      "model": "opencode-go-openai/kimi-k2.7-code",
      "description": "Carrier relay using verified Go Kimi K2.7 Code.",
      "temperature": 0.1,
      "steps": 8,
      "permission": {
        "*": "allow",
        "task": {
          "*": "allow"
        }
      },
      "prompt": "{file:./agents/relay.txt}"
    },
    "carrier-openai-terra": {
      "mode": "subagent",
      "hidden": true,
      "model": "openai/gpt-5.6-terra",
      "description": "Carrier relay using verified OpenAI GPT-5.6 Terra.",
      "temperature": 0.1,
      "steps": 8,
      "permission": {
        "*": "allow",
        "task": {
          "*": "allow"
        }
      },
      "prompt": "{file:./agents/relay.txt}"
    },
